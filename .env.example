# Frontend (Vercel)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_ANON_KEY=your-legacy-anon-key-if-used
VITE_API_BASE_URL=https://fitness-world-gymos-api.unisexgymfitnessworld.workers.dev/api

# Worker API (wrangler secrets — see workers/gymos-api/README.md)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-legacy-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,https://fitness-world-gymos.vercel.app
TRAINER_EMAILS=trainer1@example.com,trainer2@example.com

# SMS (SMSGate only — sent from the gym Android phone's SIM).
# Can also be set from the developer console after deploy.
SMSGATE_USERNAME=your-smsgate-cloud-username
SMSGATE_PASSWORD=your-smsgate-cloud-password
SMSGATE_DEVICE_ID=optional-device-id-to-pin-sending-to-one-phone
SMSGATE_SIM_NUMBER=1

# WhatsApp (self-hosted OpenWA gateway). Prefer Settings → Notifications in the app.
WA_BASE_URL=https://wa.yourserver.com
WA_API_KEY=your-openwa-operator-key
WA_SESSION_ID=gym

# Email (Google Apps Script mailer in appsscript/Code.gs). Prefer Settings → Notifications in the app.
APPSCRIPT_URL=https://script.google.com/macros/s/xxx/exec
APPSCRIPT_SECRET=your-apps-script-secret
# Long random string used to encrypt the SMSGate password at rest (AES-256-GCM).
# Set it, then re-save SMS settings once so the stored password migrates to encrypted form.
SMS_SECRET_KEY=generate-a-long-random-string-here
