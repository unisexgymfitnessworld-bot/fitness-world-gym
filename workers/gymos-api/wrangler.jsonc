{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fitness-world-gymos-api",
  "main": "src/index.js",
  "compatibility_date": "2026-06-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "RATE_LIMIT_KV", "id": "5ad3f4690a924a8b8824905c12a1cc5c" }],
  "triggers": {
    "crons": [
      "30 18 * * *",
      "30 3 * * *",
      "*/10 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
